# Place a real key only in .env.local or hosting secrets. Never commit it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model choices are provisional until the small project-specific comparison.
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_FALLBACK_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
APP_DATASET_PATH=data/catalog/places.json
APP_INDEX_PATH=data/index/places.json
APP_TIMEZONE=Asia/Almaty
# Paid calls stay OFF until credentials, ledger and independent budget review pass.
OPENROUTER_PAID_ENABLED=false
# Server requests default to preparation. Switch to demo only for an approved cutover.
# This cannot be selected through the browser request; live evaluation uses its own bucket.
OPENROUTER_RUNTIME_PURPOSE=prep
# disabled: category-only fallback; stub: disclosed bounded demo phrases; live: guarded API.
# A missing/invalid key never enables stub mode automatically.
APP_AI_MODE=disabled
# Required for paid mode: single_host_persistent. Ephemeral/multi-replica hosting
# (including Vercel) must keep paid mode disabled until a shared durable backend exists.
OPENROUTER_STORAGE=
# Absolute path required in paid mode; default is data/private/openrouter-budget.json.
# Initialize explicitly once using docs/budget.md; never reset/delete to regain budget.
OPENROUTER_LEDGER_PATH=
# Hard code ceilings below; env can reduce them but cannot raise them.
OPENROUTER_PREP_MAX_USD=2.00
OPENROUTER_DEMO_RESERVE_USD=4.00
# Live eval must explicitly opt in; this flag alone does not enforce spend.
LIVE_EVAL_ENABLED=false
LIVE_EVAL_MAX_USD=0.50
