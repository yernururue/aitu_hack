# Place a real key only in .env.local or hosting secrets. Never commit it.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Model choices are provisional until the small project-specific comparison.
OPENROUTER_MODEL=openai/gpt-6-luna
OPENROUTER_FALLBACK_MODEL=anthropic/claude-haiku-5.5
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
APP_DATASET_PATH=data/normalized/places.json
APP_INDEX_PATH=data/index/places.json
APP_TIMEZONE=Asia/Almaty
# Live eval must explicitly opt in; this flag alone does not enforce spend.
LIVE_EVAL_ENABLED=false
LIVE_EVAL_MAX_USD=0.50
